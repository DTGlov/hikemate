# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle by Expo
# and are safe to expose only because the anon key has row-level-security
# guarding it. Never put service-role keys here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
