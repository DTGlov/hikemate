# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle by Expo
# and are safe to expose only because the anon key has row-level-security
# guarding it. Never put service-role keys here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public Mapbox token, starts with pk. Get one from
# https://account.mapbox.com/access-tokens/. The SECRET token (sk.) is
# build-time only and goes in ~/.netrc (iOS) and ~/.gradle/gradle.properties
# (Android) — never in this file. See README "Mapbox Setup" for details.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
